{
  "version": 1,
  "site": {
    "url": "https://www.landal.nl"
  },
  "scope": {
    "locale": "nl",
    "subdomains": [],
    "skip": []
  },
  "depth": "standard",
  "survey": {
    "maxMinutes": null,
    "maxPages": null
  },
  "capture": {
    "perTemplate": 3,
    "coverage": true,
    "maxPages": 100
